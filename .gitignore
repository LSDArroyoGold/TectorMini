# rclone.conf es config real del dispositivo (remoto sftp del servidor) -- no
# se versiona: se pone a mano en cada dispositivo y nunca viaja por
# git/actualizar_repo.sh. Ver config/rclone.conf.ejemplo para su forma.
config/rclone.conf
__pycache__/
*.pyc

# Estado local del dispositivo (lo genera actualizar_repo.sh / los scripts)
.software.git/
.ultima_actualizacion*
log_*.txt

# Pipe que crea liblgpio (RPi.GPIO) en el directorio de trabajo de cualquier script que use GPIO
.lgd-nfy*

# Numero de serie de este equipo (lo asigna la fabrica / el servidor; no se versiona)
config/serie.txt
