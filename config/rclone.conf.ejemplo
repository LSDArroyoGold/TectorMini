# Copiar a rclone.conf (sin el .ejemplo) en ~/.config/rclone/ (el HOME real
# del usuario que corre los scripts, ver REAL_USER/USER_HOME en cada uno).
# El nombre de la seccion tiene que coincidir con SYNC_REMOTE de
# config/config_general.txt.
#
# Destino: el servidor propio del LSD-Tector ("tectorserver", Debian, SFTP
# enjaulado por usuario). No hay credenciales que venzan ni cuenta de nadie
# asociada: cada dispositivo tiene su propio usuario SFTP (tector1, tector2,
# tectormini), que solo puede escribir en su carpeta data/.
#
# Alta de un dispositivo (una sola vez):
#   1. ssh-keygen -t ed25519 -N "" -f ~/.ssh/id_ed25519_servidor   (en el
#      dispositivo; la clave privada NUNCA sale de ahi ni se commitea).
#   2. Agregar la clave PUBLICA en el servidor, en
#      /etc/ssh/tector_keys/<usuario>.
#   3. Guardar las host keys del servidor en el known_hosts del usuario:
#      ssh-keyscan 100.83.125.103 >> ~/.ssh/known_hosts
#      (IP de Tailscale, no el nombre: con el Funnel del Hub activo, el
#      nombre publico resuelve a otra IP en los equipos sin MagicDNS.)
#   4. Copiar este archivo a ~/.config/rclone/rclone.conf, chmod 600.
#   5. Verificar: rclone lsd servidor:data
[servidor]
type = sftp
host = 100.83.125.103
user = tectormini
key_file = ~/.ssh/id_ed25519_servidor
# known_hosts_file por defecto (~/.ssh/known_hosts): rclone verifica la
# identidad del servidor, no dejar en modo inseguro.
